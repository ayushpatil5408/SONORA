# ==============================================================================
# SONORA Environment Configuration Example
# Authoritative Reference: PRD.md Milestone 1
# ==============================================================================

# Frontend Configuration (Vite)
VITE_API_URL=http://localhost:8000
VITE_APP_ENV=development

# Backend Configuration (FastAPI)
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration
# Default development database uses SQLite file; PostgreSQL supported via connection string
DATABASE_URL=sqlite:///./dev.db
# DATABASE_URL=postgresql://sonora:sonora@localhost:5432/sonora_dev

# ==============================================================================
# External Music Supply Provider Configuration (Milestone 2C)
# ==============================================================================
# Jamendo Music Developer Client ID
# Obtain via official developer registration: https://developer.jamendo.com/v3.0/authentication
VITE_JAMENDO_CLIENT_ID=
